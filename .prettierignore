# Build output and vendored trees.
dist/
node_modules/
src-tauri/target/

# Regenerated by tauri-build on every compile.
src-tauri/gen/

# Generated from Rust (NFR-33) — the generator owns their formatting.
src/shared/bindings/

# npm owns this file's formatting; reformatting it produces a large,
# meaningless diff on every `npm ci`.
package-lock.json

# Rust is rustfmt's business (`cargo fmt`), not Prettier's.
src-tauri/

# Prose is hand-wrapped in this repository and the wrapping carries meaning —
# the PRD's tables, the ADR log's fixed-width columns. Prettier reflows all of
# it. Several of these files also belong to roles other than whoever is running
# the formatter.
*.md
.claude/
